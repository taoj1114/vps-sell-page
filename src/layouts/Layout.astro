---
import '../styles/global.css';
import Navbar from '../components/ui/Navbar.astro';
import Footer from '../components/ui/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "VPS雷达 - 高性能VPS评测推荐 | VPS Radar",
  description = "发现最适合您的高性能VPS方案，提供详细的参数对比、价格评测与实时优惠。",
  image = "/og-default.png",
} = Astro.props;

const canonical = Astro.url.href;
const siteName = "VPS雷达";
---

<!doctype html>
<html lang="zh-CN" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonical} />

		<title>{title}</title>
		<meta name="description" content={description} />

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL(image, Astro.url).href} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content="zh_CN" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(image, Astro.url).href} />
	</head>
	<body class="bg-bg-base dark:bg-bg-dark text-text-base dark:text-text-dark min-h-screen flex flex-col">
		<Navbar />
		<main class="flex-grow">
			<slot />
		</main>
		<Footer />
	</body>
</html>
