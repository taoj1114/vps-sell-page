---
interface Props {
  href: string;
  text?: string;
}

const { href, text = "立即购买" } = Astro.props;
---

<a 
  href={href} 
  target="_blank" 
  rel="noopener noreferrer sponsored"
  class="block w-full rounded-full bg-slate-950 px-5 py-3 text-center text-sm font-semibold text-white transition hover:bg-slate-800 dark:bg-white dark:text-slate-950 dark:hover:bg-slate-200"
>
  {text}
</a>
