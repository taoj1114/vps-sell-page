---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { appendReferralParam } from '../lib/affiliate';

const livePlans = await getCollection('plans', ({ data }) => {
  if (!data.expiryDate) return true;
  return new Date(data.expiryDate) > new Date();
});

const getPrimaryProduct = (plan) => {
  const [product] = plan.data.products ?? [];

  if (product) {
    return product;
  }

  return {
    name: plan.data.title,
    price: plan.data.price ?? 0,
    currency: plan.data.currency ?? 'USD',
    cpu: plan.data.cpu ?? 0,
    memory: plan.data.memory ?? 0,
    storage: plan.data.storage ?? 0,
    bandwidth: plan.data.bandwidth ?? '',
    location: plan.data.location ?? '',
    routing: plan.data.routing ?? '',
    billingCycle: plan.data.billingCycle ?? 'year',
    affiliateLink: plan.data.affiliateLink ?? '#',
    status: 'active',
  };
};

const getAnnualEquivalent = (product) =>
  product.billingCycle === 'month' ? product.price * 12 : product.price;

const getPriceUnit = (product) => (product.billingCycle === 'month' ? '/mo' : '/yr');

const getPricePrefix = (product) => (product.currency === 'USD' ? '$' : `${product.currency} `);

const getPriceLabel = (product) => `${getPricePrefix(product)}${product.price}${getPriceUnit(product)}`;

const plans = livePlans.sort(
  (a, b) => getAnnualEquivalent(getPrimaryProduct(a)) - getAnnualEquivalent(getPrimaryProduct(b))
);

const plansWithProviders = await Promise.all(
  plans.map(async (plan) => {
    const rawPrimaryProduct = getPrimaryProduct(plan);
    const provider = await getEntry(plan.data.provider);

    // Apply affiliate stitching at the data level
    const stitchedPrimaryProduct = {
      ...rawPrimaryProduct,
      affiliateLink: appendReferralParam(
        rawPrimaryProduct.affiliateLink, 
        provider.data.affiliateParam, 
        provider.data.affiliateValue
      )
    };

    return {
      plan,
      provider,
      primaryProduct: stitchedPrimaryProduct,
      products: plan.data.products?.length ? plan.data.products : [stitchedPrimaryProduct],
    };
  })
);

const cheapest = plansWithProviders[0];
const expiringSoon = plansWithProviders.filter(({ plan }) => plan.data.expiryDate);
const countdownTarget = expiringSoon
  .slice()
  .sort((a, b) => {
    const aExpiry = a.plan.data.expiryDate?.getTime() ?? Number.MAX_SAFE_INTEGER;
    const bExpiry = b.plan.data.expiryDate?.getTime() ?? Number.MAX_SAFE_INTEGER;
    return aExpiry - bExpiry;
  })[0]?.plan.data.expiryDate;

const getDealTags = (plan) => {
  const tags = [];
  const title = plan.data.title.toLowerCase();
  const product = getPrimaryProduct(plan);
  const bandwidth = product.bandwidth.toLowerCase();
  const routing = (product.routing ?? '').toLowerCase();
  const note = (product.note ?? '').toLowerCase();

  const isUnlimited = (str) => {
    const keywords = ['unlimited', '不限', '无限', 'inf'];
    return keywords.some(k => {
      if (/^[a-z0-9_]+$/i.test(k)) {
        return new RegExp(`\\b${k}\\b`, 'i').test(str);
      }
      return str.includes(k);
    });
  };

  if (isUnlimited(bandwidth) || isUnlimited(note)) {
    tags.push('无限流量');
  }

  // Exclude HostDare from "Big Disk" tag as requested
  if (product.storage >= 200 && plan.data.provider.id !== 'hostdare') {
    tags.push('大硬盘');
  }

  const isChinaOptimized = (str) => {
    const keywords = ['cn2', '9929', '4837', 'gia', 'china', 'premium', 'carrier', '三网', '优化', '回国'];
    return keywords.some(k => {
      if (/^[a-z0-9_]+$/i.test(k)) {
        return new RegExp(`\\b${k}\\b`, 'i').test(str);
      }
      return str.includes(k);
    });
  };

  if (isChinaOptimized(routing) || isChinaOptimized(title) || isChinaOptimized(note)) {
    tags.push('中国优化');
  }

  if (getAnnualEquivalent(product) <= 10) {
    tags.push('Under $10/yr');
  }

  if (plan.data.expiryDate) {
    tags.push('限时');
  }

  return tags;
};

const getRegionTags = (plan) => {
  const tags = [];
  const title = plan.data.title.toLowerCase();
  const product = getPrimaryProduct(plan);
  const location = product.location.toLowerCase();
  const note = (product.note ?? '').toLowerCase();

  const checkWord = (keywords) => keywords.some(k => {
    // For pure ASCII words, use word boundary to avoid substring false matches (e.g. "la" in "Switzerland")
    if (/^[a-z0-9_]+$/i.test(k)) {
      const re = new RegExp(`\\b${k}\\b`, 'i');
      return re.test(location) || re.test(title) || re.test(note);
    }
    return location.includes(k) || title.includes(k) || note.includes(k);
  });

  if (checkWord(['usa', 'united states', 'seattle', 'dallas', 'san jose', 'new york', 'los angeles', 'la', 'sj', 'us', '美国'])) {
    tags.push('美国 VPS');
  }

  if (checkWord(['japan', 'tokyo', 'osaka', 'jp', '日本'])) {
    tags.push('日本 VPS');
  }

  if (checkWord(['europe', 'london', 'amsterdam', 'frankfurt', 'paris', 'ljubljana', 'uk', 'de', 'nl', 'fr', '欧洲'])) {
    tags.push('欧洲 VPS');
  }

  if (checkWord(['singapore', 'sg', '新加坡'])) {
    tags.push('新加坡 VPS');
  }

  if (checkWord(['hong kong', 'hk', '香港'])) {
    tags.push('香港 VPS');
  }

  return tags;
};

const filterDefs = [
  {
    id: 'all',
    label: '全部',
    description: '显示所有当前可用优惠。',
    matches: plansWithProviders.length,
  },
  {
    id: '无限流量',
    label: '无限流量 VPS',
    description: '适合流量站、下载 and 高吞吐场景。',
    matches: plansWithProviders.filter(({ plan }) => getDealTags(plan).includes('无限流量')).length,
  },
  {
    id: '大硬盘',
    label: '大硬盘 VPS',
    description: '适合备份、媒体库 and 存储型服务。',
    matches: plansWithProviders.filter(({ plan }) => getDealTags(plan).includes('大硬盘')).length,
  },
  {
    id: '中国优化',
    label: '中国优化',
    description: '中国三网优化线路，适合对回国链路 and 稳定性敏感的需求。',
    matches: plansWithProviders.filter(({ plan }) => getDealTags(plan).includes('中国优化')).length,
  },
  {
    id: '美国 VPS',
    label: '美国 VPS',
    description: '适合北美节点、通用业务 and 大多数入门选项。',
    matches: plansWithProviders.filter(({ plan }) => getRegionTags(plan).includes('美国 VPS')).length,
  },
  {
    id: '日本 VPS',
    label: '日本 VPS',
    description: '适合东亚访问、轻量站点 and 日本机房用户。',
    matches: plansWithProviders.filter(({ plan }) => getRegionTags(plan).includes('日本 VPS')).length,
  },
  {
    id: '欧洲 VPS',
    label: '欧洲 VPS',
    description: '适合欧洲业务、合规部署 and 低价海外节点。',
    matches: plansWithProviders.filter(({ plan }) => getRegionTags(plan).includes('欧洲 VPS')).length,
  },
  {
    id: '新加坡 VPS',
    label: '新加坡 VPS',
    description: '适合东南亚访问、中文站点 and 延迟敏感业务。',
    matches: plansWithProviders.filter(({ plan }) => getRegionTags(plan).includes('新加坡 VPS')).length,
  },
  {
    id: '香港 VPS',
    label: '香港 VPS',
    description: '适合香港节点、低延迟回国 and 东亚业务。',
    matches: plansWithProviders.filter(({ plan }) => getRegionTags(plan).includes('香港 VPS')).length,
  },
  {
    id: 'Under $10/yr',
    label: 'Under $10/yr',
    description: 'Annual cost stays under 10 USD.',
    matches: plansWithProviders.filter(({ plan }) => getDealTags(plan).includes('Under $10/yr')).length,
  },
];

const regionFilters = filterDefs.filter((filter) =>
  ['美国 VPS', '日本 VPS', '欧洲 VPS', '新加坡 VPS', '香港 VPS'].includes(filter.label)
);

const dealFilters = filterDefs.filter((filter) =>
  ['无限流量 VPS', '大硬盘 VPS', '中国优化', 'Under $10/yr'].includes(filter.label)
);
---

<Layout>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "VPS雷达",
