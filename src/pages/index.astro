                  {primaryProduct.status === 'sold_out' && (
                    <span class="rounded-full bg-slate-200 px-2 py-0.5 text-[10px] font-bold uppercase text-slate-600 dark:bg-slate-800 dark:text-slate-400">售罄</span>
                  )}
                </div>
                <h3 id={`plan-${plan.id}`} class="text-xl font-black leading-tight text-slate-950 group-hover:text-emerald-500 dark:text-white">
                  <a href={`/vps/${plan.id}`}>
                    {plan.data.title}
                  </a>
                </h3>
                <div class="flex flex-wrap gap-2">
                  <span class="rounded-full bg-emerald-500/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-emerald-700 dark:text-emerald-300">
                    {getDealTags(plan).includes('限时') ? '限时优惠' : '长期可用'}
                  </span>
                  <span class="rounded-full bg-slate-100 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                    {getAnnualEquivalent(primaryProduct) <= 10 ? '年付$10以下' : '精选推荐'}
                  </span>
                  {getDealTags(plan).includes('无限流量') && (
                    <span class="rounded-full bg-sky-500/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-sky-700 dark:text-sky-300">
                      无限流量
                    </span>
                  )}
                  {getDealTags(plan).includes('大硬盘') && (
                    <span class="rounded-full bg-violet-500/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-violet-700 dark:text-violet-300">
                      大硬盘
                    </span>
                  )}
                  {getDealTags(plan).includes('中国优化') && (
                    <span class="rounded-full bg-rose-500/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-rose-700 dark:text-rose-300">
                      中国优化线路
                    </span>
                  )}
                  {getRegionTags(plan).includes('美国 VPS') && (
                    <span class="rounded-full bg-sky-500/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-sky-700 dark:text-sky-300">
                      美国机房
                    </span>
                  )}
                  {getRegionTags(plan).includes('日本 VPS') && (
                    <span class="rounded-full bg-amber-500/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-amber-700 dark:text-amber-300">
                      日本机房
                    </span>
                  )}
                  {getRegionTags(plan).includes('欧洲 VPS') && (
                    <span class="rounded-full bg-indigo-500/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-indigo-700 dark:text-indigo-300">
                      欧洲机房
                    </span>
                  )}
                  {getRegionTags(plan).includes('新加坡 VPS') && (
                    <span class="rounded-full bg-cyan-500/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-cyan-700 dark:text-cyan-300">
                      新加坡机房
                    </span>
                  )}
                  {getRegionTags(plan).includes('香港 VPS') && (
                    <span class="rounded-full bg-orange-500/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-orange-700 dark:text-orange-300">
                      香港机房
                    </span>
                  )}
                </div>
              </div>
              <div class="rounded-2xl bg-emerald-500/10 px-3 py-2 text-right">
                <div class="text-[11px] uppercase tracking-[0.2em] text-emerald-600 dark:text-emerald-300">起价</div>
                <div class="text-xl font-black text-emerald-600 dark:text-emerald-300">{getPriceLabel(primaryProduct)}</div>
              </div>
            </header>

            <dl class="grid grid-cols-2 gap-3 text-sm">
              <div class="rounded-2xl bg-slate-50 p-3 dark:bg-slate-950">
                <dt class="text-xs text-slate-500">处理器/内存</dt>
                <dd class="mt-1 font-semibold">{primaryProduct.cpu}核 / {primaryProduct.memory}MB</dd>
              </div>
              <div class="rounded-2xl bg-slate-50 p-3 dark:bg-slate-950">
                <dt class="text-xs text-slate-500">存储空间</dt>
                <dd class="mt-1 font-semibold">{primaryProduct.storage}GB</dd>
              </div>
              <div class="rounded-2xl bg-slate-50 p-3 dark:bg-slate-950">
                <dt class="text-xs text-slate-500">流量配额</dt>
                <dd class="mt-1 font-semibold">{primaryProduct.bandwidth}</dd>
              </div>
              <div class="rounded-2xl bg-slate-50 p-3 dark:bg-slate-950">
                <dt class="text-xs text-slate-500">机房位置</dt>
                <dd class="mt-1 font-semibold">{primaryProduct.location}</dd>
              </div>
            </dl>

            <footer class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-slate-200 pt-4 text-xs text-slate-500 dark:border-slate-800 dark:text-slate-400">
              <span>{plan.data.expiryDate ? `优惠截止 ${plan.data.expiryDate.toLocaleDateString()}` : '长期有效'}</span>
              <div class="flex gap-2">
                <a href={`/vps/${plan.id}`} class="rounded-full bg-slate-950 px-3 py-2 font-semibold text-white transition hover:bg-slate-800 dark:bg-white dark:text-slate-950 dark:hover:bg-slate-200">
                  查看详情
                </a>
                <a 
                  href={primaryProduct.status === 'sold_out' ? '#' : primaryProduct.affiliateLink} 
                  target={primaryProduct.status === 'sold_out' ? '_self' : '_blank'}
                  rel="noopener noreferrer sponsored" 
                  class={`rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-2 font-semibold text-emerald-700 transition ${primaryProduct.status === 'sold_out' ? 'opacity-50 cursor-not-allowed' : 'hover:border-emerald-500 hover:bg-emerald-500/20 dark:text-emerald-300'}`}
                >
                  {primaryProduct.status === 'sold_out' ? '已售罄' : '去购买'}
                </a>
              </div>
            </footer>
          </article>
        ))}
      </div>

      <div data-empty-state class="mt-6 hidden rounded-[1.75rem] border border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center text-slate-500 dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-400">
        当前筛选条件下没有匹配的VPS方案。
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-10 md:py-16" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="text-3xl font-black text-slate-950 dark:text-white">常见问题</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <article class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
          <h3 class="text-lg font-bold text-slate-950 dark:text-white">哪些VPS提供无限流量？</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
            VPS雷达收录了RackNerd、BandwagonHost等提供无限流量VPS的商家。这些方案适合流量站、下载和高吞吐场景。点击页面上的"无限流量VPS"筛选按钮可快速查看。
          </p>
        </article>
        <article class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
          <h3 class="text-lg font-bold text-slate-950 dark:text-white">有没有中国线路优化的VPS？</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
            有的。我们整理了CN2 GIA、9929、4837等优质回国线路的VPS方案，适合对延迟和稳定性要求高的用户。点击"中国优化"筛选可查看。
          </p>
        </article>
        <article class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
          <h3 class="text-lg font-bold text-slate-950 dark:text-white">10美元以下有哪些便宜VPS？</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
            年付10美元以下的VPS主要来自RackNerd和BandwagonHost的促销活动，通常配置为1核CPU、512MB-1GB内存、10-20GB SSD，适合个人博客和学习测试。
          </p>
        </article>
        <article class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
          <h3 class="text-lg font-bold text-slate-950 dark:text-white">日本VPS和美国VPS怎么选？</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
            亚洲用户选日本VPS延迟更低（约50-80ms），适合面向东亚用户的网站。美国VPS价格更便宜但延迟较高（约150-200ms），适合对延迟要求不高的通用场景。
          </p>
        </article>
      </div>
    </section>
  </div>

  <script is:inline>
    const countEl = document.querySelector('[data-filter-count]');
    const emptyState = document.querySelector('[data-empty-state]');
    const planCards = Array.from(document.querySelectorAll('[data-plan-card]'));
    const filterButtons = Array.from(document.querySelectorAll('[data-filter]'));
    const target = document.querySelector('[data-countdown]');
    const panel = document.querySelector('[data-countdown-panel]');
    const expiryIso = panel?.getAttribute('data-countdown-expiry') ?? '';

    const setActiveFilter = (filterId, shouldScroll = true, shouldUpdateUrl = true) => {
      const normalized = filterId || 'all';
      let visibleCount = 0;

      planCards.forEach((card) => {
        const tagList = (card.getAttribute('data-tags') ?? '').split('|').filter(Boolean);
        const match = normalized === 'all' || tagList.includes(normalized);
        card.classList.toggle('hidden', !match);
        if (match) visibleCount += 1;
      });

      if (countEl) countEl.textContent = String(visibleCount);
      if (emptyState) emptyState.classList.toggle('hidden', visibleCount !== 0);

      filterButtons.forEach((button) => {
        const active = (button.getAttribute('data-filter') ?? 'all') === normalized;
        button.setAttribute('aria-pressed', String(active));
        button.classList.toggle('ring-2', active);
        button.classList.toggle('ring-emerald-500', active);
        button.classList.toggle('bg-emerald-500/10', active);
        button.classList.toggle('border-emerald-400', active);
        button.classList.toggle('shadow-[0_20px_50px_-28px_rgba(16,185,129,0.26)]', active);
      });

      if (shouldUpdateUrl) {
        const url = new URL(window.location.href);
        if (normalized === 'all') {
          url.searchParams.delete('filter');
        } else {
          url.searchParams.set('filter', normalized);
        }
        window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
      }

      if (shouldScroll) {
        const plansList = document.querySelector('#plans-list');
        if (plansList) plansList.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    };

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        setActiveFilter(button.getAttribute('data-filter') ?? 'all');
      });
    });

    const initialFilter = new URL(window.location.href).searchParams.get('filter') ?? 'all';
    setActiveFilter(initialFilter, false, false);

    if (target && expiryIso) {
      const formatRemaining = () => {
        const expiry = new Date(expiryIso);
        const diff = expiry.getTime() - Date.now();

        if (diff <= 0) {
          target.textContent = 'Deal expired';
          return;
        }

        const totalHours = Math.floor(diff / 36e5);
        const days = Math.floor(totalHours / 24);
        const hours = totalHours % 24;
        const minutes = Math.floor((diff % 36e5) / 6e4);

        target.textContent = `${days}d ${hours}h ${minutes}m left`;
      };

      formatRemaining();
      window.setInterval(formatRemaining, 60_000);
    }
  </script>
</Layout>
