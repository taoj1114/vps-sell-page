---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allVPS = await getCollection('vps');
---

<Layout>
  <main class="max-w-6xl mx-auto p-6">
    <h1 class="text-3xl font-bold mb-8">VPS 推荐列表</h1>
    
    <!-- 简单的筛选 UI -->
    <div class="mb-8 p-4 bg-gray-100 dark:bg-gray-800 rounded-lg">
      <input 
        type="text" 
        id="searchInput" 
        placeholder="搜索名称..." 
        class="p-2 rounded border dark:bg-gray-700 w-full md:w-64"
      />
    </div>

    <div id="vpsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {allVPS.map((vps) => (
        <a href={`/vps/${vps.id}`} class="vps-card block border dark:border-gray-700 p-4 rounded-lg hover:shadow-lg transition" data-title={vps.data.title.toLowerCase()}>
          <h2 class="text-xl font-semibold mb-2">{vps.data.title}</h2>
          <p class="text-gray-600 dark:text-gray-300 text-sm mb-4">{vps.data.description}</p>
          <div class="flex justify-between items-center text-sm">
            <span class="font-bold text-lg">${vps.data.price} / {vps.data.currency}</span>
            <span class="bg-blue-100 dark:bg-blue-900 px-2 py-1 rounded">{vps.data.location}</span>
          </div>
        </a>
      ))}
    </div>
  </main>

  <script>
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const vpsCards = document.querySelectorAll('.vps-card');

    searchInput.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value.toLowerCase();
      vpsCards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        (card as HTMLElement).style.display = title.includes(val) ? 'block' : 'none';
      });
    });
  </script>
</Layout>
