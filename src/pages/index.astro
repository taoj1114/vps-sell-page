---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allPlans = await getCollection('plans');
---

<Layout>
  <main class="max-w-6xl mx-auto p-6 md:py-12">
    <div class="mb-12">
      <h1 class="text-4xl font-extrabold mb-4">精选 VPS 套餐</h1>
      <p class="text-slate-500 dark:text-slate-400">为您筛选的优质服务器资源。</p>
    </div>

    <div id="vpsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {allPlans.map((plan) => (
        <a href={`/vps/${plan.id}`} class="vps-card group relative bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-6 rounded-2xl hover:border-emerald-500/50 hover:shadow-xl transition-all">
          <h2 class="text-xl font-bold mb-4 group-hover:text-emerald-500 transition line-clamp-1">{plan.data.title}</h2>
          
          <div class="space-y-2 mb-6 text-sm text-slate-600 dark:text-slate-300">
             <div class="flex justify-between"><span>配置:</span><span class="font-mono">{plan.data.cpu}C / {plan.data.memory}MB</span></div>
             <div class="flex justify-between"><span>存储:</span><span class="font-mono">{plan.data.storage}GB</span></div>
             <div class="flex justify-between"><span>地区:</span><span>{plan.data.location}</span></div>
          </div>

          <div class="flex justify-between items-center pt-4 border-t border-slate-100 dark:border-slate-800">
            <span class="text-2xl font-black text-emerald-600 dark:text-emerald-400">${plan.data.price}</span>
            <span class="text-xs text-slate-400 uppercase font-bold">{plan.data.currency}/MO</span>
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>
