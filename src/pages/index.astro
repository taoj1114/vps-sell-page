---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const livePlans = await getCollection('plans', ({ data }) => {
  if (!data.expiryDate) return true;
  return new Date(data.expiryDate) > new Date();
});

const getAnnualEquivalent = (plan) =>
  plan.data.billingCycle === 'month' ? plan.data.price * 12 : plan.data.price;

const getPriceUnit = (plan) => (plan.data.billingCycle === 'month' ? '/mo' : '/yr');

const getPricePrefix = (plan) => (plan.data.currency === 'USD' ? '$' : `${plan.data.currency} `);

const getPriceLabel = (plan) => `${getPricePrefix(plan)}${plan.data.price}${getPriceUnit(plan)}`;

const plans = livePlans.sort((a, b) => getAnnualEquivalent(a) - getAnnualEquivalent(b));

const plansWithProviders = await Promise.all(
  plans.map(async (plan) => ({
    plan,
    provider: await getEntry(plan.data.provider),
  }))
);

const featured = plansWithProviders[0];
const cheapest = plansWithProviders[0];
const expiringSoon = plansWithProviders.filter(({ plan }) => plan.data.expiryDate);
const countdownTarget = expiringSoon
  .slice()
  .sort((a, b) => {
    const aExpiry = a.plan.data.expiryDate?.getTime() ?? Number.MAX_SAFE_INTEGER;
    const bExpiry = b.plan.data.expiryDate?.getTime() ?? Number.MAX_SAFE_INTEGER;
    return aExpiry - bExpiry;
  })[0]?.plan.data.expiryDate;

const homepageTags = ['限时折扣', '热门机房', '可直接跳转'];

const getDealTags = (plan) => {
  const tags = [];
  const title = plan.data.title.toLowerCase();
  const location = plan.data.location.toLowerCase();
  const bandwidth = plan.data.bandwidth.toLowerCase();
  const routing = (plan.data.routing ?? '').toLowerCase();

  if (bandwidth.includes('unlimited') || bandwidth.includes('不限') || bandwidth.includes('无限')) {
    tags.push('无限流量');
  }

  if (plan.data.storage >= 200 || title.includes('nvme') || title.includes('big')) {
    tags.push('大硬盘');
  }

  if (
    routing.includes('cn') ||
    routing.includes('china') ||
    routing.includes('premium') ||
    routing.includes('carrier') ||
    routing.includes('三网') ||
    routing.includes('优化')
  ) {
    tags.push('中国优化');
  }

  if (getAnnualEquivalent(plan) <= 10) {
    tags.push('Under $10/yr');
  }

  if (plan.data.expiryDate) {
    tags.push('限时');
  }

  return tags;
};

const getRegionTags = (plan) => {
  const tags = [];
  const title = plan.data.title.toLowerCase();
  const location = plan.data.location.toLowerCase();

  if (location.includes('usa') || location.includes('united states') || location.includes('seattle') || location.includes('dallas') || location.includes('san jose') || location.includes('new york') || title.includes('us')) {
    tags.push('美国 VPS');
  }

  if (location.includes('japan') || location.includes('tokyo') || location.includes('osaka') || title.includes('jp')) {
    tags.push('日本 VPS');
  }

  if (
    location.includes('europe') ||
    location.includes('london') ||
    location.includes('amsterdam') ||
    location.includes('frankfurt') ||
    location.includes('paris') ||
    location.includes('ljubljana')
  ) {
    tags.push('欧洲 VPS');
  }

  if (location.includes('singapore') || title.includes('sg')) {
    tags.push('新加坡 VPS');
  }

  return tags;
};

const filterDefs = [
  {
    id: 'all',
    label: '全部',
    description: '显示所有当前可用优惠。',
    matches: plansWithProviders.length,
  },
  {
    id: '无限流量',
    label: '无限流量 VPS',
    description: '适合流量站、下载和高吞吐场景。',
    matches: plansWithProviders.filter(({ plan }) => getDealTags(plan).includes('无限流量')).length,
  },
  {
    id: '大硬盘',
    label: '大硬盘 VPS',
    description: '适合备份、媒体库和存储型服务。',
    matches: plansWithProviders.filter(({ plan }) => getDealTags(plan).includes('大硬盘')).length,
  },
  {
    id: '中国优化',
    label: '中国优化',
    description: '中国三网优化线路，适合对回国链路和稳定性敏感的需求。',
    matches: plansWithProviders.filter(({ plan }) => getDealTags(plan).includes('中国优化')).length,
  },
  {
    id: '美国 VPS',
    label: '美国 VPS',
    description: '适合北美节点、通用业务和大多数入门选项。',
    matches: plansWithProviders.filter(({ plan }) => getRegionTags(plan).includes('美国 VPS')).length,
  },
  {
    id: '日本 VPS',
    label: '日本 VPS',
    description: '适合东亚访问、轻量站点和日本机房用户。',
    matches: plansWithProviders.filter(({ plan }) => getRegionTags(plan).includes('日本 VPS')).length,
  },
  {
    id: '欧洲 VPS',
    label: '欧洲 VPS',
    description: '适合欧洲业务、合规部署和低价海外节点。',
    matches: plansWithProviders.filter(({ plan }) => getRegionTags(plan).includes('欧洲 VPS')).length,
  },
  {
    id: '新加坡 VPS',
    label: '新加坡 VPS',
    description: '适合东南亚访问、中文站点和延迟敏感业务。',
    matches: plansWithProviders.filter(({ plan }) => getRegionTags(plan).includes('新加坡 VPS')).length,
  },
  {
    id: 'Under $10/yr',
    label: 'Under $10/yr',
    description: 'Annual cost stays under 10 USD.',
    matches: plansWithProviders.filter(({ plan }) => getDealTags(plan).includes('Under $10/yr')).length,
  },
];

const regionFilters = filterDefs.filter((filter) =>
  ['美国 VPS', '日本 VPS', '欧洲 VPS', '新加坡 VPS'].includes(filter.label)
);

const dealFilters = filterDefs.filter((filter) =>
  ['无限流量 VPS', '大硬盘 VPS', '中国优化', 'Under $10/yr'].includes(filter.label)
);
---

<Layout>
  <main class="relative overflow-hidden">
    <section class="relative">
      <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top_left,_rgba(16,185,129,0.18),_transparent_32%),radial-gradient(circle_at_top_right,_rgba(59,130,246,0.16),_transparent_28%),linear-gradient(180deg,_rgba(15,23,42,0.02),_transparent_50%)]"></div>
      <div class="mx-auto max-w-6xl px-6 py-12 md:py-16">
        <div class="grid gap-8 lg:grid-cols-[1.3fr_0.7fr] lg:items-end">
          <div class="space-y-6">
            <div class="inline-flex items-center gap-2 rounded-full border border-emerald-400/30 bg-emerald-500/10 px-4 py-2 text-sm font-semibold text-emerald-600 dark:text-emerald-300">
              <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
              本周精选 VPS 优惠
            </div>
            <div class="flex flex-wrap gap-2">
              {homepageTags.map((tag) => (
                <span class="rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-semibold text-slate-600 shadow-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
                  {tag}
                </span>
              ))}
            </div>
            <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-5">
              {regionFilters.map((filter) => (
                <button
                  type="button"
                  data-filter={filter.id}
                  class="group rounded-3xl border border-slate-200/80 bg-white/90 p-4 text-left transition hover:-translate-y-1 hover:border-emerald-500/40 hover:shadow-[0_20px_50px_-28px_rgba(15,23,42,0.32)] dark:border-slate-800 dark:bg-slate-950/80"
                >
                  <div class="text-xs font-semibold uppercase tracking-[0.22em] text-emerald-600 dark:text-emerald-300">
                    一键筛选
                  </div>
                  <div class="mt-2 text-lg font-black text-slate-950 dark:text-white">{filter.label}</div>
                  <div class="mt-2 text-sm leading-6 text-slate-500 dark:text-slate-400">{filter.description}</div>
                  <div class="mt-4 inline-flex items-center gap-2 rounded-full bg-slate-950 px-3 py-1 text-xs font-semibold text-white dark:bg-white dark:text-slate-950">
                    {filter.matches} 个结果
                  </div>
                </button>
              ))}
            </div>
            <div class="space-y-4">
              <h1 class="max-w-3xl text-4xl font-black tracking-tight text-slate-950 dark:text-white md:text-6xl">
                把限时 VPS 优惠，整理成一页能直接下单的推荐站
              </h1>
              <p class="max-w-2xl text-lg leading-8 text-slate-600 dark:text-slate-300">
                这里不是传统参数表，而是把热门促销、机房位置、优惠码和购买入口做成可扫读的导购页面，方便快速比较和点击。
              </p>
            </div>
            <div class="flex flex-wrap gap-3">
              <a href="#featured-deal" class="rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800 dark:bg-white dark:text-slate-950 dark:hover:bg-slate-200">
                查看今日主推
              </a>
              <a href="#all-deals" class="rounded-full border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-emerald-500 hover:text-emerald-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-emerald-400 dark:hover:text-emerald-300">
                浏览全部优惠
              </a>
            </div>
          </div>

          <div class="grid gap-4 rounded-3xl border border-slate-200/70 bg-white/80 p-5 shadow-[0_20px_60px_-30px_rgba(15,23,42,0.35)] backdrop-blur dark:border-slate-800 dark:bg-slate-900/70">
            <div class="rounded-2xl bg-slate-950 p-5 text-white">
              <div class="text-xs uppercase tracking-[0.24em] text-slate-400">Featured deal</div>
              <div class="mt-3 text-2xl font-black leading-tight">{featured ? featured.plan.data.title : 'No live deals'}</div>
              <p class="mt-3 text-sm leading-6 text-slate-300">
                {featured ? featured.provider.data.description : '当前没有可用优惠。'}
              </p>
            </div>
            <div
              class="rounded-2xl border border-amber-300/40 bg-amber-50 p-4 text-amber-900 dark:border-amber-400/30 dark:bg-amber-400/10 dark:text-amber-200"
              data-countdown-panel
              data-countdown-expiry={countdownTarget?.toISOString() ?? ''}
            >
              <div class="text-xs font-semibold uppercase tracking-[0.22em] text-amber-700 dark:text-amber-300">Countdown</div>
              <div class="mt-2 text-2xl font-black" data-countdown>{countdownTarget ? 'Loading countdown...' : 'No expiring deals'}</div>
              <p class="mt-2 text-sm leading-6 text-amber-800/80 dark:text-amber-200/80">
                {countdownTarget ? `当前最接近结束的优惠截止于 ${countdownTarget.toLocaleDateString()}` : '暂无限时优惠。'}
              </p>
            </div>
            <div class="grid grid-cols-3 gap-3">
              <div class="rounded-2xl bg-slate-100 p-4 dark:bg-slate-800">
                <div class="text-xs text-slate-500">Live deals</div>
                <div class="mt-2 text-2xl font-black">{plansWithProviders.length}</div>
              </div>
              <div class="rounded-2xl bg-slate-100 p-4 dark:bg-slate-800">
                <div class="text-xs text-slate-500">From</div>
                <div class="mt-2 text-2xl font-black">{cheapest ? getPriceLabel(cheapest.plan) : '--'}</div>
              </div>
              <div class="rounded-2xl bg-slate-100 p-4 dark:bg-slate-800">
                <div class="text-xs text-slate-500">Expiring</div>
                <div class="mt-2 text-2xl font-black">{expiringSoon.length}</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-6 md:py-10">
      <div class="mb-5 flex items-end justify-between gap-4">
        <div>
          <h2 class="text-2xl font-black tracking-tight md:text-3xl">需求筛选</h2>
          <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">点击任意需求，列表会即时筛选。</p>
        </div>
        <div class="text-sm font-semibold text-slate-500 dark:text-slate-400">
          当前显示 <span data-filter-count>{plansWithProviders.length}</span> 个结果
        </div>
      </div>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        {dealFilters.map((filter) => (
          <button
            type="button"
            data-filter={filter.id}
            class="rounded-[1.75rem] border border-slate-200 bg-white p-5 text-left transition hover:-translate-y-1 hover:border-emerald-500/40 hover:shadow-[0_20px_50px_-28px_rgba(15,23,42,0.28)] dark:border-slate-800 dark:bg-slate-900"
          >
            <div class="flex items-center justify-between gap-3">
              <div class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">Category</div>
              <div class="rounded-full bg-emerald-500/10 px-3 py-1 text-xs font-bold text-emerald-700 dark:text-emerald-300">
                {filter.matches} matches
              </div>
            </div>
            <h3 class="mt-4 text-xl font-black leading-tight">{filter.label}</h3>
            <p class="mt-3 text-sm leading-6 text-slate-500 dark:text-slate-400">{filter.description}</p>
          </button>
        ))}
      </div>
    </section>

    <section id="featured-deal" class="mx-auto max-w-6xl px-6 py-6 md:py-10">
      {featured && (
        <a
          href={`/vps/${featured.plan.id}`}
          class="group relative block overflow-hidden rounded-[2rem] border border-emerald-500/20 bg-slate-950 p-6 text-white shadow-[0_24px_80px_-32px_rgba(16,185,129,0.55)] transition hover:-translate-y-1 hover:border-emerald-400/40"
        >
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(16,185,129,0.24),_transparent_26%),radial-gradient(circle_at_bottom_left,_rgba(59,130,246,0.18),_transparent_26%)]"></div>
          <div class="relative grid gap-8 lg:grid-cols-[1.2fr_0.8fr]">
            <div class="space-y-4">
              <div class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-emerald-300">
                Featured promo
              </div>
              <div class="space-y-3">
                <h2 class="text-3xl font-black leading-tight md:text-4xl">
                  {featured.plan.data.title}
                </h2>
                <p class="max-w-2xl text-base leading-7 text-slate-300">
                  {featured.provider.data.description}
                </p>
              </div>
              <div class="grid gap-3 sm:grid-cols-3">
                <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                  <div class="text-xs text-slate-400">Price</div>
                  <div class="mt-2 text-2xl font-black text-emerald-300">{getPriceLabel(featured.plan)}</div>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                  <div class="text-xs text-slate-400">Promo window</div>
                  <div class="mt-2 text-lg font-bold">{featured.plan.data.expiryDate ? featured.plan.data.expiryDate.toLocaleDateString() : 'Open-ended'}</div>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                  <div class="text-xs text-slate-400">Location</div>
                  <div class="mt-2 text-lg font-bold">{featured.plan.data.location}</div>
                </div>
              </div>
            </div>

            <div class="relative rounded-[1.5rem] border border-white/10 bg-white/5 p-5">
              <div class="space-y-4">
                <div class="flex items-center justify-between text-sm text-slate-300">
                  <span>Specs</span>
                  <span class="font-semibold text-emerald-300">Click-through ready</span>
                </div>
                <div class="flex flex-wrap gap-2">
                  <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-emerald-200">Hot</span>
                  <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-slate-200">Promo</span>
                  <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-slate-200">Affiliate</span>
                </div>
                <div class="space-y-3 text-sm text-slate-200">
                  <div class="flex justify-between border-b border-white/10 pb-2"><span>CPU</span><span class="font-mono">{featured.plan.data.cpu} vCPU</span></div>
                  <div class="flex justify-between border-b border-white/10 pb-2"><span>Memory</span><span class="font-mono">{featured.plan.data.memory} MB</span></div>
                  <div class="flex justify-between border-b border-white/10 pb-2"><span>Storage</span><span class="font-mono">{featured.plan.data.storage} GB</span></div>
                  <div class="flex justify-between border-b border-white/10 pb-2"><span>Bandwidth</span><span class="font-mono">{featured.plan.data.bandwidth}</span></div>
                  <div class="flex justify-between"><span>Provider</span><span class="font-semibold">{featured.provider.data.name}</span></div>
                </div>
                <div class="mt-5 inline-flex items-center gap-2 rounded-full bg-emerald-500 px-4 py-2 text-sm font-bold text-white">
                  View deal details
                  <span aria-hidden="true">→</span>
                </div>
              </div>
            </div>
          </div>
        </a>
      )}
    </section>

    <section class="mx-auto max-w-6xl px-6 py-6 md:py-10">
      <div class="mb-5 flex items-end justify-between gap-4">
        <div>
          <h2 class="text-2xl font-black tracking-tight md:text-3xl">今日热卖</h2>
          <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">一条横向滑动的热卖带，适合快速扫到便宜和限时优惠。</p>
        </div>
      </div>
      <div class="flex gap-4 overflow-x-auto pb-2">
        {plansWithProviders.slice(0, 5).map(({ plan, provider }) => (
          <a
            href={`/vps/${plan.id}`}
            data-plan-card
            data-tags={[...getDealTags(plan), ...getRegionTags(plan)].join(' ')}
            class="min-w-[18rem] rounded-[1.5rem] border border-slate-200 bg-white p-4 transition hover:-translate-y-1 hover:border-emerald-500/40 hover:shadow-[0_18px_50px_-30px_rgba(15,23,42,0.28)] dark:border-slate-800 dark:bg-slate-900"
          >
            <div class="flex items-center justify-between gap-3">
              <div class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 dark:text-slate-400">{provider.data.name}</div>
              <div class="rounded-full bg-emerald-500/10 px-2.5 py-1 text-xs font-bold text-emerald-700 dark:text-emerald-300">{getPriceLabel(plan)}</div>
            </div>
            <h3 class="mt-3 text-lg font-black leading-tight">{plan.data.title}</h3>
            <div class="mt-3 flex flex-wrap gap-2">
              {getDealTags(plan).slice(0, 3).map((tag) => (
                <span class="rounded-full bg-slate-100 px-3 py-1 text-[11px] font-semibold text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                  {tag}
                </span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>

    <section id="all-deals" class="mx-auto max-w-6xl px-6 py-6 md:py-10">
      <div class="mb-6 flex items-end justify-between gap-4">
        <div>
          <h2 class="text-2xl font-black tracking-tight md:text-3xl">全部优惠</h2>
          <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">按价格排序，方便快速扫读和跳转。</p>
        </div>
      </div>

      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {plansWithProviders.map(({ plan, provider }) => (
          <a
            href={`/vps/${plan.id}`}
            data-plan-card
            data-tags={[...getDealTags(plan), ...getRegionTags(plan)].join(' ')}
            class="group flex h-full flex-col overflow-hidden rounded-[1.75rem] border border-slate-200 bg-white p-5 transition hover:-translate-y-1 hover:border-emerald-500/40 hover:shadow-[0_20px_60px_-30px_rgba(15,23,42,0.35)] dark:border-slate-800 dark:bg-slate-900"
          >
            <div class="mb-4 flex items-start justify-between gap-3">
              <div class="space-y-2">
                <div class="inline-flex rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-semibold text-slate-600 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-300">
                  {provider.data.name}
                </div>
                <h3 class="text-xl font-black leading-tight group-hover:text-emerald-500">
                  {plan.data.title}
                </h3>
                <div class="flex flex-wrap gap-2">
                  <span class="rounded-full bg-emerald-500/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-emerald-700 dark:text-emerald-300">
                    {getDealTags(plan).includes('限时') ? '限时' : '长期'}
                  </span>
                  <span class="rounded-full bg-slate-100 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                    {getAnnualEquivalent(plan) <= 10 ? 'Under $10/yr' : '精选推荐'}
                  </span>
                  {getDealTags(plan).includes('无限流量') && (
                    <span class="rounded-full bg-sky-500/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-sky-700 dark:text-sky-300">
                      无限流量
                    </span>
                  )}
                  {getDealTags(plan).includes('大硬盘') && (
                    <span class="rounded-full bg-violet-500/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-violet-700 dark:text-violet-300">
                      大硬盘
                    </span>
                  )}
                  {getDealTags(plan).includes('中国优化') && (
                    <span class="rounded-full bg-rose-500/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-rose-700 dark:text-rose-300">
                      中国优化
                    </span>
                  )}
                  {getRegionTags(plan).includes('美国 VPS') && (
                    <span class="rounded-full bg-sky-500/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-sky-700 dark:text-sky-300">
                      美国 VPS
                    </span>
                  )}
                  {getRegionTags(plan).includes('日本 VPS') && (
                    <span class="rounded-full bg-amber-500/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-amber-700 dark:text-amber-300">
                      日本 VPS
                    </span>
                  )}
                  {getRegionTags(plan).includes('欧洲 VPS') && (
                    <span class="rounded-full bg-indigo-500/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-indigo-700 dark:text-indigo-300">
                      欧洲 VPS
                    </span>
                  )}
                  {getRegionTags(plan).includes('新加坡 VPS') && (
                    <span class="rounded-full bg-cyan-500/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.18em] text-cyan-700 dark:text-cyan-300">
                      新加坡 VPS
                    </span>
                  )}
                </div>
              </div>
              <div class="rounded-2xl bg-emerald-500/10 px-3 py-2 text-right">
                <div class="text-[11px] uppercase tracking-[0.2em] text-emerald-600 dark:text-emerald-300">from</div>
                <div class="text-xl font-black text-emerald-600 dark:text-emerald-300">{getPriceLabel(plan)}</div>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-3 text-sm">
              <div class="rounded-2xl bg-slate-50 p-3 dark:bg-slate-950">
                <div class="text-xs text-slate-500">Compute</div>
                <div class="mt-1 font-semibold">{plan.data.cpu}C / {plan.data.memory}MB</div>
              </div>
              <div class="rounded-2xl bg-slate-50 p-3 dark:bg-slate-950">
                <div class="text-xs text-slate-500">Storage</div>
                <div class="mt-1 font-semibold">{plan.data.storage}GB</div>
              </div>
              <div class="rounded-2xl bg-slate-50 p-3 dark:bg-slate-950">
                <div class="text-xs text-slate-500">Bandwidth</div>
                <div class="mt-1 font-semibold">{plan.data.bandwidth}</div>
              </div>
              <div class="rounded-2xl bg-slate-50 p-3 dark:bg-slate-950">
                <div class="text-xs text-slate-500">Location</div>
                <div class="mt-1 font-semibold">{plan.data.location}</div>
              </div>
            </div>

            <div class="mt-4 flex items-center justify-between border-t border-slate-200 pt-4 text-xs text-slate-500 dark:border-slate-800 dark:text-slate-400">
              <span>{plan.data.expiryDate ? `Ends ${plan.data.expiryDate.toLocaleDateString()}` : 'No expiry'}</span>
              <span class="font-semibold uppercase tracking-[0.18em] text-emerald-600 dark:text-emerald-300">Details</span>
            </div>
          </a>
        ))}
      </div>

      <div data-empty-state class="mt-6 hidden rounded-[1.75rem] border border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center text-slate-500 dark:border-slate-700 dark:bg-slate-900/60 dark:text-slate-400">
        当前筛选条件下没有匹配的 VPS。
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 pb-14 pt-4 md:pb-20">
      <div class="grid gap-4 rounded-[2rem] border border-slate-200 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-900/70 md:grid-cols-3">
        <div>
          <div class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500">Step 1</div>
          <h3 class="mt-2 text-lg font-bold">快速扫优惠</h3>
          <p class="mt-2 text-sm leading-6 text-slate-500 dark:text-slate-400">先看价格、地区和带宽，快速缩小选择范围。</p>
        </div>
        <div>
          <div class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500">Step 2</div>
          <h3 class="mt-2 text-lg font-bold">进入详情页</h3>
          <p class="mt-2 text-sm leading-6 text-slate-500 dark:text-slate-400">详情页显示服务商、正文说明和外链购买入口。</p>
        </div>
        <div>
          <div class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500">Step 3</div>
          <h3 class="mt-2 text-lg font-bold">点购入站</h3>
          <p class="mt-2 text-sm leading-6 text-slate-500 dark:text-slate-400">把外部推广链接当成最终 CTA，适合做导购和联盟流量页。</p>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    const countEl = document.querySelector('[data-filter-count]');
    const emptyState = document.querySelector('[data-empty-state]');
    const planCards = Array.from(document.querySelectorAll('[data-plan-card]'));
    const filterButtons = Array.from(document.querySelectorAll('[data-filter]'));
    const target = document.querySelector('[data-countdown]');
    const panel = document.querySelector('[data-countdown-panel]');
    const expiryIso = panel?.getAttribute('data-countdown-expiry') ?? '';

    const setActiveFilter = (filterId, shouldScroll = true, shouldUpdateUrl = true) => {
      const normalized = filterId || 'all';
      let visibleCount = 0;

      planCards.forEach((card) => {
        const tagList = (card.getAttribute('data-tags') ?? '').split(' ').filter(Boolean);
        const match = normalized === 'all' || tagList.includes(normalized);
        card.classList.toggle('hidden', !match);
        if (match) visibleCount += 1;
      });

      if (countEl) countEl.textContent = String(visibleCount);
      if (emptyState) emptyState.classList.toggle('hidden', visibleCount !== 0);

      filterButtons.forEach((button) => {
        const active = (button.getAttribute('data-filter') ?? 'all') === normalized;
        button.setAttribute('aria-pressed', String(active));
        button.classList.toggle('ring-2', active);
        button.classList.toggle('ring-emerald-500', active);
        button.classList.toggle('bg-emerald-500/10', active);
        button.classList.toggle('border-emerald-400', active);
        button.classList.toggle('shadow-[0_20px_50px_-28px_rgba(16,185,129,0.26)]', active);
      });

      if (shouldUpdateUrl) {
        const url = new URL(window.location.href);
        if (normalized === 'all') {
          url.searchParams.delete('filter');
        } else {
          url.searchParams.set('filter', normalized);
        }
        window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
      }

      if (shouldScroll) {
        const allDeals = document.querySelector('#all-deals');
        if (allDeals) allDeals.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    };

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        setActiveFilter(button.getAttribute('data-filter') ?? 'all');
      });
    });

    const initialFilter = new URL(window.location.href).searchParams.get('filter') ?? 'all';
    setActiveFilter(initialFilter, false, false);

    if (target && expiryIso) {
      const formatRemaining = () => {
        const expiry = new Date(expiryIso);
        const diff = expiry.getTime() - Date.now();

        if (diff <= 0) {
          target.textContent = 'Deal expired';
          return;
        }

        const totalHours = Math.floor(diff / 36e5);
        const days = Math.floor(totalHours / 24);
        const hours = totalHours % 24;
        const minutes = Math.floor((diff % 36e5) / 6e4);

        target.textContent = `${days}d ${hours}h ${minutes}m left`;
      };

      formatRemaining();
      window.setInterval(formatRemaining, 60_000);
    }
  </script>
</Layout>
