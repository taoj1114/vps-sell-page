---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allVPS = await getCollection('vps');
---

<Layout>
  <main class="max-w-6xl mx-auto p-6 md:py-12">
    <div class="mb-12">
      <h1 class="text-4xl font-extrabold mb-4">精选 VPS 推荐</h1>
      <p class="text-slate-500 dark:text-slate-400">发现高性能、高性价比的 VPS 方案。</p>
      
      <div class="mt-8">
        <input 
          type="text" 
          id="searchInput" 
          placeholder="搜索 VPS 名称..." 
          class="w-full md:w-80 px-4 py-2 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 focus:ring-2 focus:ring-emerald-500 transition"
        />
      </div>
    </div>

    <div id="vpsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {allVPS.map((vps) => (
        <a href={`/vps/${vps.id}`} class="vps-card group relative bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-6 rounded-2xl hover:border-emerald-500/50 hover:shadow-xl transition-all" data-title={vps.data.title.toLowerCase()}>
          <h2 class="text-xl font-bold mb-2 group-hover:text-emerald-500 transition">{vps.data.title}</h2>
          <p class="text-slate-600 dark:text-slate-400 text-sm mb-6 line-clamp-2">{vps.data.description}</p>
          <div class="flex justify-between items-center text-sm font-semibold">
            <span class="text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/50 px-3 py-1 rounded-full">${vps.data.price} / {vps.data.currency}</span>
            <span class="text-slate-500">{vps.data.location}</span>
          </div>
        </a>
      ))}
    </div>
  </main>

  <script>
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const vpsCards = document.querySelectorAll('.vps-card');

    searchInput.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value.toLowerCase();
      vpsCards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        (card as HTMLElement).style.display = title.includes(val) ? 'block' : 'none';
      });
    });
  </script>
</Layout>
