---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AffiliateButton from '../../components/AffiliateButton.astro';
import { appendReferralParam } from '../../lib/affiliate';

export async function getStaticPaths() {
  const plans = await getCollection('plans');
  return plans.map((plan) => ({
    params: { slug: plan.id },
    props: { plan },
  }));
}

const { plan } = Astro.props;
const provider = await getEntry(plan.data.provider);
const { Content } = await render(plan);

const getPrimaryProduct = (plan) => {
  const [product] = plan.data.products ?? [];

  if (product) {
    return product;
  }

  return {
    name: plan.data.title,
    price: plan.data.price ?? 0,
    currency: plan.data.currency ?? 'USD',
    cpu: plan.data.cpu ?? 0,
    memory: plan.data.memory ?? 0,
    storage: plan.data.storage ?? 0,
    bandwidth: plan.data.bandwidth ?? '',
    location: plan.data.location ?? '',
    routing: plan.data.routing ?? '',
    billingCycle: plan.data.billingCycle ?? 'year',
    affiliateLink: plan.data.affiliateLink ?? '#',
    status: 'active',
    note: '',
  };
};

const getProducts = (plan) => plan.data.products?.length ? plan.data.products : [getPrimaryProduct(plan)];

const getAnnualEquivalent = (product) =>
  product.billingCycle === 'month' ? product.price * 12 : product.price;

const getPriceUnit = (product) => (product.billingCycle === 'month' ? '/mo' : '/yr');

const getPricePrefix = (product) => (product.currency === 'USD' ? '$' : `${product.currency} `);

const getPriceLabel = (product) => `${getPricePrefix(product)}${product.price}${getPriceUnit(product)}`;

const primaryProduct = getPrimaryProduct(plan);
const products = getProducts(plan).map(p => ({
  ...p,
  affiliateLink: appendReferralParam(p.affiliateLink, provider.data.affiliateParam, provider.data.affiliateValue)
}));

const stitchedPrimaryProduct = {
  ...primaryProduct,
  affiliateLink: appendReferralParam(primaryProduct.affiliateLink, provider.data.affiliateParam, provider.data.affiliateValue)
};

const isExpired = plan.data.expiryDate && new Date(plan.data.expiryDate) < new Date();

const getDealTags = (plan) => {
  const tags = [];
  const title = plan.data.title.toLowerCase();
  const product = getPrimaryProduct(plan);
  const bandwidth = product.bandwidth.toLowerCase();
  const routing = (product.routing ?? '').toLowerCase();
  const note = (product.note ?? '').toLowerCase();

  const isUnlimited = (str) => 
    str.includes('unlimited') || 
    str.includes('不限') || 
    str.includes('无限') || 
    str.includes('inf');

  if (isUnlimited(bandwidth) || isUnlimited(note)) {
    tags.push('无限流量');
  }

  if (product.storage >= 200 || title.includes('nvme') || title.includes('big') || note.includes('storage')) {
    tags.push('大硬盘');
  }

  const isChinaOptimized = (str) =>
    str.includes('cn2') ||
    str.includes('9929') ||
    str.includes('4837') ||
    str.includes('gia') ||
    str.includes('china') ||
    str.includes('premium') ||
    str.includes('carrier') ||
    str.includes('三网') ||
    str.includes('优化') ||
    str.includes('回国');

  if (isChinaOptimized(routing) || isChinaOptimized(title) || isChinaOptimized(note)) {
    tags.push('中国优化');
  }

  if (getAnnualEquivalent(product) <= 10) {
    tags.push('Under $10/yr');
  }

  if (plan.data.expiryDate) {
    tags.push('限时');
  }

  return tags;
};

const dealTags = getDealTags(plan);

const getRegionTags = (plan) => {
  const tags = [];
  const title = plan.data.title.toLowerCase();
  const product = getPrimaryProduct(plan);
  const location = product.location.toLowerCase();
  const note = (product.note ?? '').toLowerCase();

  const check = (keywords) => keywords.some(k => location.includes(k) || title.includes(k) || note.includes(k));

  if (check(['usa', 'united states', 'seattle', 'dallas', 'san jose', 'new york', 'los angeles', 'la', 'sj', 'us', '美国'])) {
    tags.push('美国 VPS');
  }

  if (check(['japan', 'tokyo', 'osaka', 'jp', '日本'])) {
    tags.push('日本 VPS');
  }

  if (check(['europe', 'london', 'amsterdam', 'frankfurt', 'paris', 'ljubljana', 'uk', 'de', 'nl', 'fr', '欧洲'])) {
    tags.push('欧洲 VPS');
  }

  if (check(['singapore', 'sg', '新加坡'])) {
    tags.push('新加坡 VPS');
  }

  if (check(['hong kong', 'hk', '香港'])) {
    tags.push('香港 VPS');
  }

  return tags;
};

const regionTags = getRegionTags(plan);

const categoryLinks = [
  ...dealTags.includes('无限流量') ? [{ label: '无限流量 VPS', href: '/?filter=无限流量#plans-list' }] : [],
  ...dealTags.includes('大硬盘') ? [{ label: '大硬盘 VPS', href: '/?filter=大硬盘#plans-list' }] : [],
  ...dealTags.includes('中国优化') ? [{ label: '中国优化', href: '/?filter=中国优化#plans-list' }] : [],
  ...dealTags.includes('Under $10/yr') ? [{ label: 'Under $10/yr', href: '/?filter=Under%20%2410%2Fyr#plans-list' }] : [],
  ...regionTags.includes('美国 VPS') ? [{ label: '美国 VPS', href: '/?filter=美国 VPS#plans-list' }] : [],
  ...regionTags.includes('日本 VPS') ? [{ label: '日本 VPS', href: '/?filter=日本 VPS#plans-list' }] : [],
  ...regionTags.includes('欧洲 VPS') ? [{ label: '欧洲 VPS', href: '/?filter=欧洲 VPS#plans-list' }] : [],
  ...regionTags.includes('新加坡 VPS') ? [{ label: '新加坡 VPS', href: '/?filter=新加坡 VPS#plans-list' }] : [],
  ...regionTags.includes('香港 VPS') ? [{ label: '香港 VPS', href: '/?filter=香港 VPS#plans-list' }] : [],
];

const providerIntro = provider.data.intro ?? provider.data.description;
const paymentMethods = provider.data.paymentMethods ?? [];
const refundPolicy = provider.data.refundPolicy ?? '请以服务商最新条款为准。';
const testIP = provider.data.testIP;
const testFile = provider.data.testFile;
---

<Layout title={`${plan.data.title} - ${provider.data.name} 推荐`} description={providerIntro}>
  <main class="mx-auto max-w-6xl px-6 py-10 md:py-14">
    <div class="mb-6 flex flex-wrap items-center gap-3">
      <a href="/" class="rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-600 transition hover:border-emerald-500 hover:text-emerald-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-300">
        &larr; 返回列表
      </a>
      {categoryLinks.map((link) => (
        <a
          href={link.href}
          class="rounded-full border border-emerald-500/20 bg-emerald-500/10 px-4 py-2 text-sm font-semibold text-emerald-700 transition hover:border-emerald-500 hover:bg-emerald-500/20 dark:text-emerald-300"
        >
          返回 {link.label}
        </a>
      ))}
    </div>

    {isExpired && (
      <div class="mb-6 rounded-[1.25rem] border border-red-200 bg-red-50 p-4 text-center font-bold text-red-700 dark:border-red-800 dark:bg-red-900/30 dark:text-red-300">
        该优惠活动已于 {plan.data.expiryDate?.toLocaleDateString()} 结束，相关优惠可能已失效。
      </div>
    )}

    <section class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <div class="flex flex-wrap items-center gap-2">
          <span class="rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-700 dark:text-emerald-300">
            服务商背景
          </span>
          <span class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-semibold text-slate-600 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-300">
            {provider.data.name}
          </span>
        </div>
        <h1 class="mt-4 text-3xl font-black tracking-tight text-slate-950 dark:text-white md:text-5xl">
          {provider.data.name} 背景介绍
        </h1>
        <p class="mt-4 max-w-2xl text-base leading-7 text-slate-600 dark:text-slate-300">
          {providerIntro}
        </p>

        {/* Speedtest Info */}
        {(testIP || testFile) && (
          <div class="mt-6 p-4 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
            <div class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-3">网络测试 / Speedtest</div>
            <div class="space-y-2">
              {testIP && (
                <div class="flex items-center justify-between text-sm">
                  <span class="text-slate-500">测试 IP:</span>
                  <button 
                    data-copy={testIP}
                    class="font-mono font-bold text-slate-950 dark:text-white hover:text-emerald-600 transition"
                  >
                    {testIP} <span class="ml-1 text-[10px] text-slate-400">点击复制</span>
                  </button>
                </div>
              )}
              {testFile && (
                <div class="flex items-center justify-between text-sm">
                  <span class="text-slate-500">下载测试:</span>
                  <a href={testFile} class="font-mono font-bold text-emerald-600 hover:underline">100MB.bin</a>
                </div>
              )}
            </div>
          </div>
        )}

        <div class="mt-6 flex flex-wrap gap-3">
          <a href={provider.data.website} target="_blank" rel="noopener noreferrer" class="rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800 dark:bg-white dark:text-slate-950 dark:hover:bg-slate-200">
            访问服务商官网
          </a>
        </div>
        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          {dealTags.map((tag) => (
            <a
              href={`/?filter=${tag}#plans-list`}
              class="rounded-full border border-slate-200 bg-slate-50 px-3 py-2 text-center text-xs font-semibold text-slate-600 transition hover:border-emerald-500 hover:text-emerald-600 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-300"
            >
              {tag}
            </a>
          ))}
          {regionTags.map((tag) => (
            <a
              href={`/?filter=${tag}#plans-list`}
              class="rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-2 text-center text-xs font-semibold text-emerald-700 transition hover:border-emerald-500 hover:bg-emerald-500/20 dark:text-emerald-300"
            >
              {tag}
            </a>
          ))}
        </div>
      </div>

      <div class="rounded-[2rem] border border-slate-200 bg-slate-50 p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <div class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">优惠活动名称 / 持续时间</div>
        <h2 class="mt-3 text-2xl font-black text-slate-950 dark:text-white">{plan.data.title}</h2>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          <div class="rounded-2xl bg-white p-4 dark:bg-slate-950">
            <div class="text-xs text-slate-500 dark:text-slate-400">活动发布</div>
            <div class="mt-2 text-base font-semibold text-slate-950 dark:text-white">{plan.data.pubDate.toLocaleDateString()}</div>
          </div>
          <div class="rounded-2xl bg-white p-4 dark:bg-slate-950">
            <div class="text-xs text-slate-500 dark:text-slate-400">活动截止</div>
            <div class="mt-2 text-base font-semibold text-slate-950 dark:text-white">{plan.data.expiryDate ? plan.data.expiryDate.toLocaleDateString() : '长期有效'}</div>
          </div>
          <div class="rounded-2xl bg-white p-4 dark:bg-slate-950">
            <div class="text-xs text-slate-500 dark:text-slate-400">起始价格</div>
            <div class="mt-2 text-2xl font-black text-emerald-600 dark:text-emerald-300">{getPriceLabel( stitchedPrimaryProduct )}</div>
          </div>
          <div class="rounded-2xl bg-white p-4 dark:bg-slate-950">
            <div class="text-xs text-slate-500 dark:text-slate-400">主要机房</div>
            <div class="mt-2 text-base font-semibold text-slate-950 dark:text-white">{ stitchedPrimaryProduct.location }</div>
          </div>
        </div>
        <div class="mt-6">
          <AffiliateButton 
            href={ stitchedPrimaryProduct.status === 'sold_out' ? '#' : stitchedPrimaryProduct.affiliateLink } 
            text={ stitchedPrimaryProduct.status === 'sold_out' ? '已售罄' : '直达主推优惠' } 
          />
        </div>
      </div>
    </section>

    <section class="mt-8 rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
        <div>
          <div class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">活动产品</div>
          <h2 class="mt-2 text-2xl font-black text-slate-950 dark:text-white">可直接购买的套餐列表</h2>
        </div>
        <div class="text-sm text-slate-500 dark:text-slate-400">
          {products.length} 个套餐
        </div>
      </div>

      {/* Desktop Table View */}
      <div class="hidden md:block overflow-x-auto">
        <table class="min-w-full border-separate border-spacing-0">
          <thead>
            <tr class="text-left text-xs uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">
              <th class="border-b border-slate-200 px-4 py-3 dark:border-slate-800">产品</th>
              <th class="border-b border-slate-200 px-4 py-3 dark:border-slate-800">价格</th>
              <th class="border-b border-slate-200 px-4 py-3 dark:border-slate-800">配置</th>
              <th class="border-b border-slate-200 px-4 py-3 dark:border-slate-800">状态</th>
              <th class="border-b border-slate-200 px-4 py-3 dark:border-slate-800">直达</th>
            </tr>
          </thead>
          <tbody>
            {products.map((product) => (
              <tr class={`align-top text-sm ${product.status === 'sold_out' ? 'opacity-60 grayscale-[0.5]' : ''}`}>
                <td class="border-b border-slate-100 px-4 py-4 dark:border-slate-800">
                  <div class="font-bold text-slate-950 dark:text-white">{product.name}</div>
                  {product.couponCode && (
                    <div class="mt-2 inline-flex items-center gap-2">
                      <span class="text-[10px] uppercase font-bold text-slate-400">Coupon:</span>
                      <button data-copy={product.couponCode} class="px-2 py-0.5 rounded-md bg-amber-500/10 text-amber-600 font-mono text-xs font-bold border border-amber-500/20 hover:bg-amber-500/20 transition">
                        {product.couponCode}
                      </button>
                    </div>
                  )}
                  <div class="mt-2 text-xs text-slate-500">{product.routing || '标准线路'} · {product.location}</div>
                </td>
                <td class="border-b border-slate-100 px-4 py-4 font-black text-emerald-600 dark:border-slate-800 dark:text-emerald-300 text-lg">{getPriceLabel(product)}</td>
                <td class="border-b border-slate-100 px-4 py-4 dark:border-slate-800 text-slate-600 dark:text-slate-300">
                  <div class="font-medium text-slate-800 dark:text-slate-100">{product.cpu}C / {product.memory}MB</div>
                  <div class="mt-1 text-xs text-slate-500 dark:text-slate-400">{product.storage}GB / {product.bandwidth}</div>
                </td>
                <td class="border-b border-slate-100 px-4 py-4 dark:border-slate-800">
                   <span class={`rounded-full px-2 py-0.5 text-[10px] font-bold uppercase ${product.status === 'sold_out' ? 'bg-slate-200 text-slate-600 dark:bg-slate-800 dark:text-slate-400' : 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400'}`}>
                    {product.status === 'sold_out' ? 'Sold Out' : 'Active'}
                   </span>
                </td>
                <td class="border-b border-slate-100 px-4 py-4 dark:border-slate-800">
                  <a
                    href={product.status === 'sold_out' ? '#' : product.affiliateLink}
                    target={product.status === 'sold_out' ? '_self' : '_blank'}
                    rel="noopener noreferrer"
                    class={`inline-flex rounded-full px-4 py-2 text-xs font-semibold transition ${
                      product.status === 'sold_out' 
                        ? 'bg-slate-200 text-slate-500 cursor-not-allowed dark:bg-slate-800 dark:text-slate-500' 
                        : 'bg-slate-950 text-white hover:bg-slate-800 dark:bg-white dark:text-slate-950 dark:hover:bg-slate-200'
                    }`}
                  >
                    {product.status === 'sold_out' ? '已售罄' : '直达'}
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {/* Mobile Card View */}
      <div class="grid gap-4 md:hidden">
        {products.map((product) => (
          <div class={`p-5 rounded-2xl border ${product.status === 'sold_out' ? 'bg-slate-50/50 border-slate-200 opacity-70 grayscale dark:bg-slate-950/50 dark:border-slate-800' : 'bg-white border-slate-100 shadow-sm dark:bg-slate-950 dark:border-slate-800'}`}>
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="font-black text-lg text-slate-950 dark:text-white">{product.name}</h3>
                <div class="text-xs text-slate-500 mt-1">{product.location} · {product.routing || '标准线路'}</div>
              </div>
              <div class="text-right">
                <div class="text-xl font-black text-emerald-600 dark:text-emerald-400">{getPriceLabel(product)}</div>
              </div>
            </div>
            
            <div class="grid grid-cols-2 gap-3 mb-5">
              <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-100 dark:border-slate-800">
                <div class="text-[10px] uppercase font-bold text-slate-400 mb-1">Compute</div>
                <div class="text-sm font-bold">{product.cpu}C / {product.memory}MB</div>
              </div>
              <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-100 dark:border-slate-800">
                <div class="text-[10px] uppercase font-bold text-slate-400 mb-1">Storage</div>
                <div class="text-sm font-bold">{product.storage}GB / {product.bandwidth}</div>
              </div>
            </div>

            {product.couponCode && (
              <div class="mb-4 flex items-center justify-between p-3 rounded-xl bg-amber-500/5 border border-dashed border-amber-500/20">
                <span class="text-xs font-bold text-amber-700">优惠码</span>
                <button data-copy={product.couponCode} class="px-3 py-1 rounded-lg bg-amber-500/10 text-amber-600 font-mono text-sm font-black transition active:scale-95">
                  {product.couponCode}
                </button>
              </div>
            )}

            <a
              href={product.status === 'sold_out' ? '#' : product.affiliateLink}
              target={product.status === 'sold_out' ? '_self' : '_blank'}
              class={`block w-full py-3 rounded-xl text-center text-sm font-black transition ${
                product.status === 'sold_out'
                  ? 'bg-slate-200 text-slate-500 dark:bg-slate-800'
                  : 'bg-slate-950 text-white active:scale-[0.98] dark:bg-white dark:text-slate-950'
              }`}
            >
              {product.status === 'sold_out' ? '项目已售罄' : '立即抢购'}
            </a>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-8 grid gap-6 lg:grid-cols-[1fr_1fr]">
      <div class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <div class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">服务商 VPS 测评</div>
        <h2 class="mt-2 text-2xl font-black text-slate-950 dark:text-white">第三方测评 / 参考文章</h2>
        <p class="mt-3 text-sm leading-7 text-slate-600 dark:text-slate-300">
          参考独立测评页，方便在下单前交叉验证商家口碑、速度和稳定性。
        </p>
        {provider.data.reviewLink ? (
          <a href={provider.data.reviewLink} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex rounded-full border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-emerald-500 hover:text-emerald-600 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-200 dark:hover:border-emerald-400 dark:hover:text-emerald-300">
            查看详细测评
          </a>
        ) : (
          <p class="mt-4 text-sm text-slate-500 dark:text-slate-400">当前服务商尚未提供外站测评连接。</p>
        )}
      </div>

      <div class="grid gap-6">
        <div class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <div class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">商家支持的支付方式</div>
          <h2 class="mt-2 text-2xl font-black text-slate-950 dark:text-white">付款方式</h2>
          <div class="mt-4 flex flex-wrap gap-2">
            {paymentMethods.length > 0 ? (
              paymentMethods.map((method) => (
                <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                  {method}
                </span>
              ))
            ) : (
              <span class="text-sm text-slate-500 dark:text-slate-400">未填写</span>
            )}
          </div>
        </div>

        <div class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <div class="text-xs font-semibold uppercase tracking-[0.24em] text-slate-500 dark:text-slate-400">商家退款政策</div>
          <h2 class="mt-2 text-2xl font-black text-slate-950 dark:text-white">退款政策</h2>
          <p class="mt-4 text-sm leading-7 text-slate-600 dark:text-slate-300">{refundPolicy}</p>
        </div>
      </div>
    </section>

    <section class="mt-8 rounded-[2rem] border border-slate-200 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-900/70">
      <div class="prose prose-slate max-w-none dark:prose-invert">
        <Content />
      </div>
    </section>
  </main>

  <script is:inline>
    document.querySelectorAll('[data-copy]').forEach(button => {
      button.addEventListener('click', () => {
        const text = button.getAttribute('data-copy');
        navigator.clipboard.writeText(text).then(() => {
          const original = button.innerHTML;
          button.textContent = 'Copied!';
          button.classList.add('bg-emerald-500/20', 'text-emerald-600');
          setTimeout(() => {
            button.innerHTML = original;
            button.classList.remove('bg-emerald-500/20', 'text-emerald-600');
          }, 2000);
        });
      });
    });
  </script>
</Layout>
