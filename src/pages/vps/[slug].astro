---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AffiliateButton from '../../components/AffiliateButton.astro';

export async function getStaticPaths() {
  const vpsEntries = await getCollection('vps');
  return vpsEntries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout>
  <main class="max-w-4xl mx-auto p-6">
    <a href="/" class="text-blue-500 hover:underline mb-4 block">&larr; 返回列表</a>
    <h1 class="text-4xl font-bold mb-4">{entry.data.title}</h1>
    
    <div class="grid grid-cols-2 gap-4 mb-8 bg-gray-100 dark:bg-gray-800 p-6 rounded-lg">
      <div><strong>价格:</strong> {entry.data.price} {entry.data.currency}</div>
      <div><strong>CPU:</strong> {entry.data.cpu} Core</div>
      <div><strong>内存:</strong> {entry.data.memory} MB</div>
      <div><strong>存储:</strong> {entry.data.storage} GB</div>
      <div><strong>带宽:</strong> {entry.data.bandwidth}</div>
      <div><strong>地区:</strong> {entry.data.location}</div>
      <div><strong>评分:</strong> {entry.data.rating}/5</div>
    </div>

    <div class="prose dark:prose-invert max-w-none">
      <Content />
    </div>

    <div class="mt-8">
      <AffiliateButton href={entry.data.affiliateLink} />
    </div>
  </main>
</Layout>
